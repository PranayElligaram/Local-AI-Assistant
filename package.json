{
  "name": "jarvis",
  "private": true,
  "version": "0.0.0",
  "description": "A Windows desktop voice assistant with an Iron Man holographic interface. Local-first: a deterministic router, JARVIS-owned tools and a local Ollama model (granite4:3b, qwen3.5:4b fallback). No Claude or cloud account required.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:writes": "node scripts/start.mjs --writes",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart.ps1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "node --import tsx --test tests/*.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:offline": "node scripts/e2e.mjs --offline",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "node bridge/server.mjs --writes",
    "app": "node scripts/apps.mjs",
    "jobs": "node scripts/jobs.mjs",
    "diagnostics": "node scripts/diagnostics.mjs",
    "setup": "node scripts/diagnostics.mjs"
  },
  "volta": {
    "node": "22.23.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
