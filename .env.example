# JARVIS — example environment file
# ===================================================================
# EVERYTHING HERE IS OPTIONAL. JARVIS runs with no file at all: the bridge
# authenticates off your existing Claude Code login, and both halves of the
# voice fall back to the browser's own speech.
#
# Copy this to .env.local and add only what you want to change.
#
#   .env.local   preferred. Read by BOTH halves: the bridge reads every
#                variable from it, and Vite passes the VITE_-prefixed ones to
#                the browser. Git-ignored.
#   .env         also read by the bridge, for compatibility. Git-ignored.
#
# A real environment variable always wins over the file, so
# `$env:JARVIS_MODEL='claude-sonnet-5'; npm start` still overrides it.
#
# Only VITE_-prefixed values ever reach the browser. NEVER put a secret behind
# a VITE_ prefix: it is compiled into the page and anyone who opens devtools
# has it. The ElevenLabs key below is unprefixed on purpose — it stays in the
# bridge, which makes the calls on the browser's behalf.


# ===================================================================
# BRIDGE (the Node server, bridge/server.mjs)
# ===================================================================

# Port for the WebSocket + HTTP endpoints. Default 8787. Change
# VITE_BRIDGE_URL to match if you change it.
# JARVIS_BRIDGE_PORT=8787

# The model the bridge asks Claude Code to run. Default claude-opus-5.
# JARVIS_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh. Default medium — enough
# thinking to be useful, fast enough for a spoken conversation.
# JARVIS_EFFORT=medium

# Allow effectful tools (shell, files, sending, device control). Off by
# default, so JARVIS can look at anything and change nothing. Prefer
# `npm run bridge:writes` / `npm run start:writes`, which set it for one run.
# Read decideTool() in bridge/policy.mjs before turning this on permanently.
# JARVIS_ALLOW_WRITES=false

# Let JARVIS read and drive YOUR Chrome through the Claude browser extension.
# Off by default in this fork: it reaches every signed-in tab, which is a
# capability to grant deliberately.
# JARVIS_ENABLE_CHROME=false

# The camera tools (look / watch). On by default; the browser's own permission
# prompt and camera indicator are the real gate.
# JARVIS_ENABLE_CAMERA=true

# Where the agent runs, relative to the repository unless absolute. Default
# ./workspace. It is created if missing and git-ignored.
# JARVIS_WORKSPACE=workspace

# Opt-in, project-local MCP servers, in Claude Code's `{"mcpServers": {...}}`
# shape. Default ./jarvis.mcp.json, which does not exist until you write one.
# Your GLOBAL ~/.claude.json is never read, in any case.
# JARVIS_MCP_CONFIG=jarvis.mcp.json

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# localhost:5173-5199 and 4173-4199 are already allowed.
# JARVIS_ALLOWED_ORIGINS=

# Accept clients that send no Origin header (curl, scripts, native apps). Off,
# because that is also what local malware looks like.
# JARVIS_ALLOW_NO_ORIGIN=false

# Extra directories the /file endpoint may serve images from, comma separated.
# Your home directory and the temp directory are always included.
# JARVIS_FILE_ROOTS=


# ===================================================================
# ELEVENLABS (optional — a better voice and sharper hearing)
# ===================================================================
# With a key, JARVIS speaks in the ElevenLabs voice and transcribes with
# Scribe. Without one, everything still works on the browser's own speech, and
# a key that stops working falls back to it mid-conversation rather than going
# silent. The key stays in the bridge and is never logged or sent to the page.

# ELEVENLABS_API_KEY=

# Voice id. JARVIS_VOICE_ID and ELEVENLABS_VOICE_ID are both accepted; the
# default is George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Seconds to wait for speech generation before giving up and using the browser
# voice for that line. 1-60, default 10. One wait, no retries.
# ELEVENLABS_TIMEOUT_S=10


# ===================================================================
# FRONTEND (Vite) — the VITE_ ones, read by the browser
# ===================================================================

# Which brain the browser talks to. Default bridge. `direct` calls the Claude
# API from the page and needs VITE_ANTHROPIC_API_KEY in the bundle; it is not
# the supported path here.
# VITE_BACKEND=bridge

# Where the bridge listens. Keep in step with JARVIS_BRIDGE_PORT.
# VITE_BRIDGE_URL=ws://localhost:8787

# Which microphone to use. Blank means the system default, which is usually
# right. Otherwise: a 0-based device index, or part of the device name as
# Windows shows it ("Yeti", "Realtek"). A name matching more than one device is
# refused rather than guessed at; a preference that no longer matches falls
# back to the default and says so in the diagnostics panel (press D).
# VITE_JARVIS_MIC=

# Browser text-to-speech engine when no ElevenLabs voice is active.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice in the browser. Better sound, much slower to start.
# VITE_TTS_ENGINE=system

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro.
# VITE_KOKORO_VOICE=bm_george

# Prefer the ElevenLabs voice from the browser when a key is available.
# VITE_USE_ELEVENLABS=false

# Picovoice AccessKey. Optional. With one, the wake word runs offline in WASM
# with far fewer false triggers; without it, "Hey Jarvis" is matched in the
# transcript, which is the default and needs no account.
# VITE_PICOVOICE_ACCESS_KEY=

# Anthropic API key — DIRECT MODE ONLY, and it ships to the browser. The
# default bridge mode never reads it.
# VITE_ANTHROPIC_API_KEY=
