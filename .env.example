# ============================================================
# Jarvis Configuration
# ============================================================

# ------------------------------------------------------------
# ElevenLabs speech
# Keep disabled until API key and Voice ID are configured.
# ------------------------------------------------------------

ENABLE_ELEVENLABS=false

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

JARVIS_WELCOME_PHRASE=Welcome home.

ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_PCM_SAMPLE_RATE=24000

JARVIS_WELCOME_CACHE_ENABLED=true
JARVIS_WELCOME_CACHE_DIR=

# Delay before welcome speech starts after Spotify action
JARVIS_AFTER_SONG_DELAY_S=1.0


# ------------------------------------------------------------
# Startup actions
# ------------------------------------------------------------

# Spotify
OPEN_SPOTIFY=true

# spotify: opens Spotify Desktop through the registered Windows URI handler.
# An https://open.spotify.com/... URL remains supported as well.
SONG_URI=spotify:track:YOUR_TRACK_ID
# Optional 1-based monitor number; blank leaves the window where Windows opens it.
SPOTIFY_MONITOR=
# Minimize the located Spotify window after dispatching the URI. When true,
# SPOTIFY_MONITOR is intentionally ignored.
SPOTIFY_MINIMIZE=false


# Claude
OPEN_CLAUDE=true
# claude:// opens Claude Desktop. Use https://claude.ai/new for browser mode.
CLAUDE_URL=claude://claude.ai/new
# Desktop Claude only; CLAUDE_CHROME_MONITOR remains browser-mode configuration.
CLAUDE_MONITOR=
# Move first, then use the Windows maximize command on the selected monitor.
CLAUDE_MAXIMIZE=false


# Netflix packaged Windows app (discovered from the installed Start-app list)
OPEN_NETFLIX=false
NETFLIX_MONITOR=
NETFLIX_MAXIMIZE=false


# Cursor
FOCUS_CURSOR=false

# WARNING:
# F11 is currently a toggle.
# If Cursor is already fullscreen, this may take it out of fullscreen.
CURSOR_FULLSCREEN=false


# ------------------------------------------------------------
# Microphone
# Leave blank to use the Windows default microphone.
# You can alternatively provide a numeric device index or unique
# microphone-name substring.
# ------------------------------------------------------------

JARVIS_INPUT_DEVICE=


# ------------------------------------------------------------
# Chrome window behaviour (used only for HTTP(S) Claude or legacy browser actions)
# ------------------------------------------------------------

OPEN_CHROME_FULLSCREEN=true

# Monitor used for the Claude Chrome window.
# 1 normally means your primary monitor.
CLAUDE_CHROME_MONITOR=1

# Keep false unless separate Chrome profiles are specifically needed.
CHROME_SEPARATE_SITE_PROFILES=false

# Maximum time to wait for a newly opened Chrome window.
CHROME_NEW_WINDOW_WAIT_S=25

# Used where normal Chrome window sizing is required.
CHROME_WINDOW_WIDTH=1400
CHROME_WINDOW_HEIGHT=900


# ------------------------------------------------------------
# Legacy upstream Binance action
# Keep disabled unless you deliberately want this functionality.
# ------------------------------------------------------------

OPEN_BINANCE=false

BINANCE_BTC_URL=https://www.binance.com/en/trade/BTC_USDT
BINANCE_CHROME_MONITOR=3
