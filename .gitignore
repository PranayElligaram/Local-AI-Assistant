# Secrets and machine-local configuration. The ElevenLabs key lives in one of
# these; neither is ever committed.
.env
.env.local
.env.*.local
.env.txt

# The user's own application aliases and portable-app paths (npm run app).
jarvis.apps.json
jarvis.apps.json.tmp

# Legacy opt-in MCP file from the Claude-era bridge. No longer read; kept
# ignored so an old copy with tokens in it can never be committed.
jarvis.mcp.json

# Runtime state: the PID and run files, the application cache, old workspace.
.jarvis/
workspace/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Copied out of node_modules by scripts/start.mjs — 34MB of build output.
public/mediapipe/

